ckable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,286][1144,334]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\">\r\n                                <android.widget.TextView index=\"2\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"本产品资费有效期3年，如双方在有效期届满前无异议，有效期自动续展，每次续展3年。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,286][1131,338]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              </android.view.View>\r\n                              <android.widget.TextView index=\"18\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"退订方式：可通过中国移动APP-已订业务，或拨打10086人工客服退订，也可前往线下营业厅操作退订。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,331][1144,445]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" co