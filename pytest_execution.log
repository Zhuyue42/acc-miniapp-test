android.widget.TextView index=\"30\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（2）为保证您的权益，每月最后一天20:00~23:59不开放本业务受理。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1699][1144,1813]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"31\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（3）同一时间，每位用户仅可订购1个同系列的随心听产品，但可以订购多个不同系列的随心听产品。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1810][1144,1924]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"32\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（4）酷狗随心听会员包、酷狗随心听会员体验包不可同时订购。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1920][1144,2031]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entr