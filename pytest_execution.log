sed=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1423][1131,1543]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              </android.view.View>\r\n                              <android.widget.TextView index=\"28\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"5、办理限制\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1537][1144,1595]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"29\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（1）订购时手机账户余额需大于产品月资费，若余额低于产品月资费，则无法订购。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1589][1144,1703]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"30\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（2）为保证您的权益，每月最后一天20:00~23:59不开放本业务受理。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1699][1144,1813]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"31\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（3）同一时间，每位用户仅可订购1个同系列的随心听产品，但可以订购多个不同系列的随心听产品。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1810][1144,1924]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"32\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（4）酷狗随心听会员包、酷狗随心听会员体验包不可同时订购。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,1920][1144,2031]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"33\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（5）产品资费有效期内，不可重复订购。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,2028][1144,2086]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"34\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（6）广东省客户如为2/3G不限量套餐、4G随心王客户不可办理，如需办理，需先主动取消以上套餐生效后方可办理。部分套餐（如WAP不限量套餐等）无法办理，具体办理规则请详询10086。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,2083][1144,2307]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"35\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"（7）广西省客户暂不支持订购本产品。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,2301][1144,2359]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                              <android.widget.TextView index=\"36\" package=\"com.kugou.android\" class=\"android.widget.TextView\" text=\"6、因权益方内部调整，我们可能会变更、终止与权益方的合作，您可能无法继续通过中国移动接受该权益方提供产品。届时您已订购的连续包月产品可通过后台帮您进行退订或退费，同时公司将会及时公告或告知。如因此导致您无法使用或购买产品的，请您理解我们无须对此承担责任。可能给您带来的不便，敬请谅解。\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[55,2356][1144,2619]\" displayed=\"true\" hint=\"\" a11y-important=\"false\" screen-reader-focusable=\"false\" drawing-order=\"0\" showing-hint=\"false\" text-entry-key=\"false\" dismissable=\"false\" a11y-focused=\"false\" heading=\"false\" live-region=\"0\" context-clickable=\"false\" content-invalid=\"false\" tooltip-text=\"\" window-id=\"345\" />\r\n                            </android.view.View>\r\n                          </android.view.View>\r\n                        </android.webkit.WebView>\r\n                      </android.webkit.WebView>\r\n                    </android.widget.FrameLayout>\r\n                    <android.view.View index=\"1\" package=\"com.kugou.android\" class=\"android.view.View\" text=\"\" resource-id=\"com.kugou.android:id/fal\" checkable=\"false\" checked=\"false\" clickable=\"false\" enabled=\"true\" focusable=\"false\" focused=\"false\" long-clickable=\"false\" password=\"false\" scrollable=\"false\" selected=\"false\" bounds=\"[0,286][1200,2618]\" displayed=\"true\" a11y-important=\"false\" screen-reader-focusable=\"false